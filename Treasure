<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>TEMARAM</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0b0b0b;color:#fff;font-family:system-ui;height:100vh;display:flex;flex-direction:column}
.top{padding:12px 16px;background:#111;border-bottom:1px solid #222;display:flex;align-items:center;gap:12px}
.top h1{font-size:16px;letter-spacing:1px}
.dot{width:8px;height:8px;background:#00ff88;border-radius:50%}
#lock{display:flex;flex:1;align-items:center;justify-content:center;padding:20px}
.card{background:#15151f;padding:28px 24px;border-radius:20px;width:100%;max-width:360px;border:1px solid #2a2a3a;text-align:center}
.card h2{font-size:22px;margin-bottom:8px}
.card p{color:#aaa;font-size:14px;margin-bottom:20px}
input{width:100%;padding:14px;border-radius:12px;border:1px solid #333;background:#0a0a0f;color:#fff;font-size:18px;text-align:center;letter-spacing:4px}
.btn{width:100%;margin-top:16px;padding:14px;border-radius:12px;border:0;background:#f5d76e;color:#000;font-weight:800;font-size:15px}
.error{color:#ff5555;font-size:13px;margin-top:10px;display:none}
#chat{display:none;flex-direction:column;flex:1;overflow:hidden}
.chat-head{padding:10px 14px;background:#15151f;display:flex;align-items:center;gap:10px;border-bottom:1px solid #222}
.chat-head img{width:36px;height:36px;border-radius:50%;background:#333}
.msgs{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;background:#0b0b0b}
.name{font-size:11px;color:#888;margin-bottom:3px}
.bubble{max-width:78%;padding:10px 14px;border-radius:18px;font-size:15px;line-height:1.4;position:relative}
.left{align-self:flex-start;background:#23232e;border-bottom-left-radius:6px}
.right{align-self:flex-end;background:#0084ff;color:#fff;border-bottom-right-radius:6px}
.time{font-size:10px;opacity:.6;margin-left:8px}
.input-bar{padding:10px;background:#15151f;border-top:1px solid #222;display:flex;gap:8px;align-items:center}
.input-bar div{flex:1;background:#0a0a0f;border:1px solid #333;border-radius:20px;padding:10px 14px;color:#aaa;font-size:14px}
</style>
</head>
<body>
<div class="top"><div class="dot"></div><h1>TEMARAM</h1></div>

<div id="lock">
<div class="card">
<h2>🔒 Private Treasure</h2>
<p>Enter password to open<br>treasure-temaram.vercel.app</p>
<input id="pw" type="text" placeholder="••••••" maxlength="6" inputmode="numeric">
<button class="btn" onclick="check()">ENTER</button>
<div id="err" class="error">Wrong password! Hint: 140300</div>
<p style="margin-top:14px;font-size:12px;color:#666">Pw nya 140300</p>
</div>
</div>

<div id="chat">
<div class="chat-head">
<img>
<div><b style="font-size:14px">Ujang Kedu 💙</b><div style="font-size:11px;color:#888">Treasure Temaram Group</div></div>
</div>
<div class="msgs" id="msgs">
<div class="bubble right">Ngeredau, tapi enggak dibales <span class="time">04:40</span></div>
<div class="bubble right">Terus tiba-tiba telepon duluan <span class="time">04:40</span></div>
